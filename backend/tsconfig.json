{
"compilerOptions":{
  "target": "es2022", 
  "module": "commonjs",
  "esModuleInterop": true, 
  "allowJs": true,
  "forceConsistentCasingInFileNames": true, 
  "strict": true, 
  "skipLibCheck": true,
  "outDir":"./dist", 
  "rootDir": "./", 
  "typeRoots":["./node_modules/@types","./src/@types"]
},
"include":["src/**/*","main.ts","index.ts"]
}
